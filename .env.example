# Logos v2 gateway settings.
#
# The gateway reads ~/.logos/.env (or $LOGOS_HOME/.env) and then a .env in the directory it is
# started from. Everything here is optional: with no settings the gateway listens on port 8091,
# keeps its state in ~/.logos and generates its own JWT secret on first start.
#
# Agents are NOT configured here. Each agent is defined in agents/<name>.yaml and keeps its own
# settings on its home volume. See infra/agent-image/README.md and scripts/logos-agent.

# --- Gateway ---------------------------------------------------------------------------

# Where the gateway keeps its state (auth database, config.yaml, logs). Default: ~/.logos
# Set this in the shell, not in a .env file: it decides which .env file is read.
# LOGOS_HOME=

# HTTP port. Default: 8091
# LOGOS_PORT=8091

# Timezone used when the gateway shows the current time, e.g. Europe/London. Default: system.
# LOGOS_TIMEZONE=

# --- Auth ------------------------------------------------------------------------------

# Secret used to sign login cookies. Generate with: openssl rand -hex 32
# If unset, one is generated and stored in $LOGOS_HOME/.jwt_secret.
# LOGOS_JWT_SECRET=

# Set to true only when the gateway is served over HTTPS (behind a reverse proxy).
# LOGOS_COOKIE_SECURE=

# Create the admin account at startup instead of through the /setup page.
# LOGOS_ADMIN_EMAIL=
# LOGOS_ADMIN_PASSWORD=
# LOGOS_ADMIN_NAME=

# --- Agents ----------------------------------------------------------------------------

# How the gateway finds agents. Unset: none (chat answers 503 no_agents_running).
# openshell: OpenShell 0.1 sandboxes created from agents/<name>.yaml (work in progress).
# LOGOS_SANDBOX_BACKEND=

