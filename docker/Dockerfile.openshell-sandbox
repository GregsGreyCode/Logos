# Hermes agent sandbox image for OpenShell
#
# Build:
#   docker build -f docker/Dockerfile.openshell-sandbox -t logos-hermes-sandbox .
#
# Usage (via OpenShellExecutor — handled automatically):
#   openshell sandbox create --name hermes-X --from logos-hermes-sandbox --detach
#
# The Hermes gateway starts on port 8080 inside the sandbox.
# OpenShellExecutor forwards a host port (8200-8299) to this via SSH tunnel.

# OpenShell base sandbox image (community catalog)
FROM ghcr.io/nvidia/openshell/sandbox:latest

# ── System dependencies ────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    iproute2 \
    python3.11 \
    python3-pip \
    python3.11-venv \
    && rm -rf /var/lib/apt/lists/*

# ── Install uv for fast dependency resolution ─────────────────────────────
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# ── Install Logos/Hermes ────────────────────────────────────────────────────
WORKDIR /app

# Install dependencies first (cached layer)
COPY pyproject.toml ./
RUN uv venv venv --python 3.11 --clear
ENV VIRTUAL_ENV="/app/venv"
ENV PATH="/app/venv/bin:$PATH"
ENV PYTHONPATH="/app"
RUN uv pip install ".[messaging]" || true

# Copy source
COPY . /app/
RUN uv pip install -e ".[messaging]"

# ── Non-root user for reduced privilege ────────────────────────────────────
# OpenShell requires a user+group named "sandbox" in the image.
RUN groupadd -g 10001 sandbox \
 && useradd -m -d /home/sandbox -u 10001 -g sandbox sandbox \
 && mkdir -p /home/sandbox/.hermes/{sessions,logs,memories,skills} \
 && mkdir -p /hermes \
 && chown -R 10001:10001 /home/sandbox /app /hermes
# Create .profile/.bashrc so OpenShell login shells activate the venv
RUN echo 'export PATH="/app/venv/bin:$PATH"' > /home/sandbox/.profile \
 && echo 'export PATH="/app/venv/bin:$PATH"' > /home/sandbox/.bashrc \
 && echo 'export PYTHONPATH="/app"' >> /home/sandbox/.profile \
 && echo 'export PYTHONPATH="/app"' >> /home/sandbox/.bashrc \
 && chown 10001:10001 /home/sandbox/.profile /home/sandbox/.bashrc
USER sandbox
ENV HOME=/home/sandbox

# ── Runtime config ─────────────────────────────────────────────────────────
ENV HERMES_PORT=8080
ENV HERMES_HOME=/home/sandbox/.hermes

# Mount point for SOUL.md — OpenShellExecutor bind-mounts the resolved
# soul content here as read-only at sandbox creation time.

EXPOSE 8080

# ── Entrypoint ─────────────────────────────────────────────────────────────
# OpenShell runs the CMD as the container's main process.
# HERMES_INSTANCE_NAME, HERMES_SOUL, HERMES_TOOLSETS etc. are injected
# by OpenShellExecutor via --env flags at sandbox creation time.
COPY --chmod=755 docker/entrypoint-sandbox.sh /app/entrypoint.sh
CMD ["/app/entrypoint.sh"]
