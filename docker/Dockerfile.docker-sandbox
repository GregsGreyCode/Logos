# Hermes agent sandbox image — Docker-only mode (no OpenShell dependency)
#
# Build:
#   docker build -f Dockerfile.docker-sandbox -t logos-hermes-sandbox .
#
# Usage (via DockerSandboxExecutor — handled automatically):
#   docker run -d --rm --name hermes-X -p 127.0.0.1:8200:8080 logos-hermes-sandbox
#
# This image is functionally equivalent to the OpenShell sandbox image but
# uses a standard python:3.11-slim base instead of the OpenShell sandbox
# base, so it works on all platforms that have Docker (including Windows).

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    iproute2 \
 && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Install dependencies first (cached layer)
COPY pyproject.toml ./
RUN uv venv venv --python 3.11 --clear
ENV VIRTUAL_ENV="/app/venv"
ENV PATH="/app/venv/bin:$PATH"
ENV PYTHONPATH="/app"
RUN uv pip install ".[messaging]" || true

# Copy source
COPY . /app/
RUN uv pip install -e ".[messaging]"

# Non-root user for reduced privilege.
# Named "sandbox" for OpenShell compatibility (required user+group name).
# Also works for plain Docker mode — the name doesn't matter there.
RUN groupadd -g 10001 sandbox \
 && useradd -m -d /home/sandbox -u 10001 -g sandbox sandbox \
 && mkdir -p /home/sandbox/.hermes/{sessions,logs,memories,skills} \
 && mkdir -p /home/sandbox/.logos/{logs,sessions} \
 && echo 'export PATH="/app/venv/bin:$PATH"' > /home/sandbox/.profile \
 && echo 'export PATH="/app/venv/bin:$PATH"' > /home/sandbox/.bashrc \
 && echo 'export PYTHONPATH="/app"' >> /home/sandbox/.profile \
 && echo 'export PYTHONPATH="/app"' >> /home/sandbox/.bashrc \
 && chown -R 10001:10001 /home/sandbox /app
USER sandbox
ENV HOME=/home/sandbox
# OpenShell's Landlock policy restricts ~/. Use /tmp for writable state.
ENV HERMES_HOME=/tmp/hermes
ENV LOGOS_HOME=/tmp/logos

# Runtime defaults — overridden by DockerSandboxExecutor via -e flags
ENV HERMES_PORT=8080
EXPOSE 8080

# Entrypoint wrapper that ensures venv and state dirs are set up,
# then starts the gateway.  OpenShell strips Docker ENV vars, so
# we hardcode the paths here.
RUN printf '#!/bin/bash\nexport PATH="/app/venv/bin:$PATH"\nexport PYTHONPATH="/app"\nexport LOGOS_HOME="/tmp/logos"\nexport HERMES_HOME="/tmp/hermes"\nexport HERMES_PORT="${HERMES_PORT:-8080}"\nmkdir -p /tmp/logos/logs /tmp/hermes/sessions /tmp/hermes/memories\nexec /app/venv/bin/python -m gateway.run "$@"\n' > /app/entrypoint.sh \
 && chmod +x /app/entrypoint.sh

CMD ["/app/entrypoint.sh"]
