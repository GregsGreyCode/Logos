# Logos E2E Test Configuration
# Copy to .env and fill in values

# Base URL of the Logos instance to test
BASE_URL=http://localhost:8080

# Admin credentials (used for most tests)
ADMIN_USERNAME=Greg
ADMIN_PASSWORD=changeme

# Optional: second user for multi-user tests
USER2_USERNAME=
USER2_PASSWORD=

# Optional: LM Studio endpoint for model tests
LMSTUDIO_URL=http://192.168.1.117:1234

# Timeouts (ms)
DEFAULT_TIMEOUT=10000
CHAT_RESPONSE_TIMEOUT=60000
