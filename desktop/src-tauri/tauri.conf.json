{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logos",
  "version": "0.1.0",
  "identifier": "com.gregsgreycode.logos",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Logos",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "url": "http://localhost:8091/login",
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#010409"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Thin desktop client for the Logos self-hosted agent platform",
    "longDescription": "Logos is a self-hosted platform for running AI agents on your own hardware. This desktop app is a thin WebView wrapper around the web UI — configure it with the URL of your Logos gateway and everything else runs server-side."
  }
}
