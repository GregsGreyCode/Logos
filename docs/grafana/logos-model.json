        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, turn) (rate(logos_voice_turn_seconds_bucket{outcome=\"ok\"}[$__rate_interval])))",
          "legendFormat": "{{turn}} p50",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, turn) (rate(logos_voice_turn_seconds_bucket{outcome=\"ok\"}[$__rate_interval])))",
          "legendFormat": "{{turn}} p95",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "logos_voice_probe_seconds",
          "legendFormat": "nightly check {{turn}}",
          "refId": "C",
          "range": true
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
