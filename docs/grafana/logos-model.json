          },
          "expr": "histogram_quantile(0.95, sum by (le, who) (rate(logos_model_request_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{who}} p95",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "House speaker: seconds per question",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "min": 0
