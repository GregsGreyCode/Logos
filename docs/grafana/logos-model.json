          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "logos_model_kv_cache_usage_ratio{server=~\"$server\"}",
          "legendFormat": "KV cache (older llama.cpp only)",
          "refId": "B",
          "range": true
