#!/usr/bin/env python3
"""Run the model gateway that agents with `model.gateway: true` send their model calls through.

Usage:
  scripts/logos-models up       write the config from agents/*.yaml and start (or restart) the gateway
  scripts/logos-models status   show the address, paid providers and each agent's monthly budget
  scripts/logos-models down     stop and remove the container (spend history is kept on its volume)

The local model server (LM Studio), which the gateway passes local model calls on to:
  scripts/logos-models local               what the agents need, what is loaded, and anything extra
  scripts/logos-models local load          load what the agents need, with their context size
  scripts/logos-models local unload <id>   unload one model
  scripts/logos-models local tidy          unload loaded models that no agent uses
  scripts/logos-models local use <id>      switch every agent to another model on the server, for
                                           example a small one while the graphics card is needed
                                           for something else. Restarts the agents (about 2 minutes)
  scripts/logos-models local use default   back to the model in each agent's definition

Paid providers are switched on by API keys in ~/.config/logos/models.env, for example:
  ANTHROPIC_API_KEY=sk-ant-...
An agent may use one only if its definition lists it under model.allow, and never beyond its
budget.monthly_usd. See docs/model-gateway.md.
"""
import importlib.util, sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent


def _load(name):
    spec = importlib.util.spec_from_file_location(f"logos_{name}", REPO / "gateway" / f"{name}.py")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = mod
    spec.loader.exec_module(mod)
    return mod


def use(rt, art, lm, model_id):
    """Point every agent at ``model_id`` (or back at its own with "default") and restart them."""
    import yaml
    override = REPO / "agents" / art.ALL_LOCAL
    current = (yaml.safe_load(override.read_text()) or {}) if override.exists() else {}
    http = rt.runner.http
    before = lm.wanted({n: rt.load(n) for n in rt.defined()})
    if model_id == "default":
        current.pop("model", None)
    else:
        try:
            known = [m for base in before for m in lm.available(http, base)]
        except OSError:
            known = None                                # server off: trust the name, load it later
        if known is not None and model_id not in known:
            sys.exit(f"{model_id} is not on the model server. Available:\n  " + "\n  ".join(known))
        current["model"] = {"default": model_id}
    if current:
        override.write_text("# Written by scripts/logos-models local use. Untracked; applies to every agent.\n"
                            + yaml.safe_dump(current, sort_keys=False))
    elif override.exists():
        override.unlink()
    agents = {n: rt.load(n) for n in rt.defined()}
    server_up = True
    for base, models in lm.wanted(agents).items():
        try:
            have = lm.loaded(http, base)
            for old in before.get(base, {}):            # free the memory first; other models are left alone
                if old not in models and old in have:
                    lm.unload(http, base, old); print(f"{old}: unloaded")
            for mid, ctx in models.items():
                print(f"{mid}: {'loaded' if lm.ensure(http, base, mid, ctx) else 'already loaded'}")
        except OSError:
            server_up = False
            print(f"the model server at {base} is not answering; the agents are switched anyway and "
                  "the model loads when it is back (scripts/logos-models local load)")
    phases = rt.phases()
    for name in sorted(agents):
        if phases.get(name, art.MISSING) != art.MISSING:
            rt.up(name)
    if server_up:
        print(lm.report(http, agents))
    return 0


def local(args):
    art = _load("agent_runtime")
    lm = _load("local_models")
    rt = art.AgentRuntime(REPO)
    http = rt.runner.http
    agents = {name: rt.load(name) for name in rt.defined()}
    want = lm.wanted(agents)
    try:
        if args[:1] == ["load"]:
            for base, models in want.items():
                for model_id, ctx in models.items():
                    did = lm.ensure(http, base, model_id, ctx)
                    print(f"{model_id}: {'loaded' if did else 'already loaded'}")
        elif args[:1] == ["unload"] and len(args) == 2:
            for base in want:
                if args[1] in lm.loaded(http, base):
                    lm.unload(http, base, args[1]); print(f"{args[1]}: unloaded")
        elif args[:1] == ["use"] and len(args) == 2:
            return use(rt, art, lm, args[1])
        elif args[:1] == ["tidy"]:
            for base, models in want.items():
                for model_id in lm.strays(lm.loaded(http, base), models):
                    lm.unload(http, base, model_id); print(f"{model_id}: unloaded")
        elif args:
            print(__doc__); return 2
        print(lm.report(http, agents))
    except OSError as e:
        sys.exit(f"local model server: {e}")
    return 0


def main(argv):
    if len(argv) >= 2 and argv[1] == "local":
        return local(argv[2:])
    if len(argv) != 2 or argv[1] not in ("up", "status", "down"):
        print(__doc__); return 0 if len(argv) > 1 and argv[1] in ("-h", "--help") else 2
    art = _load("agent_runtime")
    mg = _load("model_gateway")
    gw = mg.ModelGateway(art.AgentRuntime(REPO))
    try:
        if argv[1] == "up":
            print("model gateway: started" if gw.up() else "model gateway: already up to date")
        elif argv[1] == "down":
            gw.down(); print("model gateway: stopped (volume kept)")
        print(gw.status()) if argv[1] != "down" else None
    except (ValueError, TimeoutError, art.AgentRuntimeError) as e:
        sys.exit(f"model gateway: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
