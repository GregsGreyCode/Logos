#!/usr/bin/env python3
"""Create, inspect and remove Logos v2 agents (OpenShell 0.1 sandboxes running hermes).

Usage:
  scripts/logos-agent up <name>       create or recreate the sandbox from agents/<name>.yaml
  scripts/logos-agent down <name>     delete the sandbox (volumes are kept)
  scripts/logos-agent status [name]   show sandbox phase
  scripts/logos-agent exec <name> -- <cmd...>   run a command inside the sandbox

Each agent has two labelled Docker volumes (docs/adr/0001):
  logos-home-<name>  -> /opt/data        hermes home (config, SOUL.md, memories, sessions)
  logos-brain-<name> -> /opt/data/brain   markdown vault
"""
# The logic lives in gateway/agent_runtime.py, shared with the gateway's OpenShell backend.
import importlib.util, sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent


def _runtime_module():
    # Loaded by path: the CLI needs only this one file, not the whole gateway package.
    spec = importlib.util.spec_from_file_location("logos_agent_runtime", REPO / "gateway" / "agent_runtime.py")
    mod = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = mod
    spec.loader.exec_module(mod)
    return mod


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__); return 0
    art = _runtime_module()
    rt = art.AgentRuntime(REPO)
    cmd, name = argv[1], (argv[2] if len(argv) > 2 else None)
    try:
        if cmd == "up" and name:
            return rt.up(name)
        if cmd == "down" and name:
            rt.down(name); print(f"{name}: deleted (volumes kept)"); return 0
        if cmd == "status":
            for n in ([name] if name else rt.defined()):
                print(f"{n}: {rt.phase(n)}")
            return 0
        if cmd == "exec" and name and "--" in argv:
            return rt.exec(name, argv[argv.index("--") + 1:])
    except art.AgentRuntimeError as e:
        sys.exit(str(e))
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
