#!/usr/bin/env python3
"""Nightly export of the small, irreplaceable Logos data, for the offsite backup.

The whole VM is backed up nightly (vzdump to TrueNAS), but VM archives only reach B2 every 28
days. This writes the parts that matter most to one folder that the nightly restic run sends
offsite, so losing the site costs at most a day of them:

  calendar.bundle            the calendars, as a git bundle with their whole history
  calendar-etc.tar.gz        Radicale's settings and people (bcrypt hashes), without the
                             calendar service's password (it is recreated on the next `up`)
  brain-<agent>.bundle       each agent's brain, a git bundle with its whole history
  agent-<agent>.tar.gz       each agent's memories and scheduled jobs (cron/jobs.json)
  state-<agent>.db.gz        each agent's hermes database: its conversations, reasoning and
                             tool calls (a consistent SQLite copy, taken while it runs)
  matrix.tar.gz              the Matrix server (accounts, rooms, encrypted history, media).
                             Matrix is stopped for the few seconds the copy takes, so its
                             database is consistent; phones and agents reconnect by themselves
  auth.db.gz                 the dashboard's accounts and sessions (a consistent SQLite copy)
  manifest.json              when it ran, and the size and sha256 of every file

Everything else stays covered by the nightly VM backup only.

Usage:  scripts/logos-backup-export [--dir DIR]
  DIR defaults to $LOGOS_BACKUP_DIR, else ~/backup-export. The export replaces DIR/latest
  atomically; restic keeps the history. It also writes DIR/logos_backup_export.prom for the
  node_exporter textfile collector (last success time and size). Exit status 0 = success.

Restore a bundle:  git clone calendar.bundle collections
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

HELPER = "alpine/git:latest"          # the same helper image logos-agent uses for brains
SQLITE_HELPER = "python:3.12-alpine"  # has Python's sqlite3, for consistent copies of live databases
MATRIX = "logos-matrix"
AUTH_DB = Path.home() / ".logos" / "auth.db"

# Copies a live SQLite database with SQLite's own backup API (safe while hermes writes to it),
# then gzips it. argv: source destination.
SQLITE_COPY = (
    "import gzip, shutil, sqlite3, sys, os\n"
    "src = sqlite3.connect('file:' + sys.argv[1] + '?mode=ro', uri=True)\n"
    "tmp = sys.argv[2] + '.tmp'\n"
    "dst = sqlite3.connect(tmp)\n"
    "src.backup(dst); dst.close(); src.close()\n"
    "with open(tmp, 'rb') as f, gzip.open(sys.argv[2], 'wb') as g: shutil.copyfileobj(f, g)\n"
    "os.remove(tmp)\n")
SKIP = ("bench",)                     # test agents are not worth an offsite copy


def sh(cmd, check=True):
    p = subprocess.run(cmd, text=True, capture_output=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd[:4])}...: {(p.stderr or p.stdout).strip()[-400:]}")
    return p.stdout


def volumes():
    names = sh(["docker", "volume", "ls", "-q"]).split()
    agents = sorted(v[len("logos-brain-"):] for v in names if v.startswith("logos-brain-")
                    and not v[len("logos-brain-"):].startswith(SKIP))
    return names, agents


def sqlite_copy(src: Path, dest: Path) -> None:
    """A consistent, gzipped copy of a live SQLite database on this machine."""
    sh([sys.executable, "-c", SQLITE_COPY, str(src), str(dest)])


def export_state_dbs(out: Path, agents) -> None:
    """Each agent's hermes state.db, copied with SQLite's backup API inside a helper container.
    The home volume is mounted writable only because SQLite readers of a WAL database need the
    -shm file; nothing is written to it."""
    for a in agents:
        sh(["docker", "run", "--rm", "--network", "none", "-u", "0", "-v", f"logos-home-{a}:/h",
            "-v", f"{out}:/out", "--entrypoint", "sh", SQLITE_HELPER, "-c",
            f"test -f /h/state.db || exit 0; python3 -c \"$0\" /h/state.db /out/state-{a}.db.gz "
            f"&& chown {os.getuid()}:{os.getgid()} /out/state-{a}.db.gz", SQLITE_COPY])


def export_matrix(out: Path) -> None:
    """The Matrix volume as a tarball. Its embedded database (RocksDB) is only consistent at
    rest, so the server is stopped for the copy and always started again afterwards."""
    running = sh(["docker", "inspect", "-f", "{{.State.Running}}", MATRIX], check=False).strip() == "true"
    if running:
        sh(["docker", "stop", "-t", "30", MATRIX])
    try:
        sh(["docker", "run", "--rm", "--network", "none", "-v", f"{MATRIX}:/m:ro", "-v", f"{out}:/out",
            "--entrypoint", "sh", HELPER, "-c",
            f"tar -czf /out/matrix.tar.gz -C /m . && chown {os.getuid()}:{os.getgid()} /out/matrix.tar.gz"])
    finally:
        if running:
            sh(["docker", "start", MATRIX])


def export(out: Path) -> dict:
    names, agents = volumes()
    mounts, script = [], ["set -e", "cd /out", "G='git -c safe.directory=*'"]
    if "logos-calendar" in names:
        mounts += ["-v", "logos-calendar:/cal:ro"]
        script += ["$G -C /cal/collections bundle create /out/calendar.bundle --all",
                   "tar -czf /out/calendar-etc.tar.gz -C /cal etc --exclude etc/service-password"]
    for a in agents:
        mounts += ["-v", f"logos-brain-{a}:/brain-{a}:ro"]
        script.append(f"$G -C /brain-{a} bundle create /out/brain-{a}.bundle --all")
        if f"logos-home-{a}" in names:
            mounts += ["-v", f"logos-home-{a}:/home-{a}:ro"]
            script.append(f"tar -czf /out/agent-{a}.tar.gz -C /home-{a} "
                          f"$(cd /home-{a} && ls -d memories cron/jobs.json 2>/dev/null)")
    script.append(f"chown -R {os.getuid()}:{os.getgid()} /out")
    sh(["docker", "run", "--rm", "--network", "none", "--entrypoint", "sh", *mounts,
        "-v", f"{out}:/out", HELPER, "-c", " && ".join(script)])
    export_state_dbs(out, [a for a in agents if f"logos-home-{a}" in names])
    if MATRIX in names:
        export_matrix(out)
    if AUTH_DB.exists():
        sqlite_copy(AUTH_DB, out / "auth.db.gz")
    files = {}
    for f in sorted(out.iterdir()):
        files[f.name] = {"bytes": f.stat().st_size, "sha256": hashlib.sha256(f.read_bytes()).hexdigest()}
    if not files:
        raise RuntimeError("nothing was exported")
    return {"finished": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "agents": agents, "files": files}


def main(argv):
    base = Path(argv[argv.index("--dir") + 1] if "--dir" in argv else
                os.environ.get("LOGOS_BACKUP_DIR") or Path.home() / "backup-export").expanduser()
    base.mkdir(parents=True, exist_ok=True)
    # The helper container writes as root, which an NFS share maps to nobody. So it writes to a
    # local staging folder, and this script (the logos user) copies the result onto the share.
    stage = Path.home() / ".cache" / "logos-backup-export"
    shutil.rmtree(stage, ignore_errors=True)
    stage.mkdir(parents=True)
    work = base / f".new-{os.getpid()}"
    shutil.rmtree(work, ignore_errors=True)
    try:
        manifest = export(stage)
        (stage / "manifest.json").write_text(json.dumps(manifest, indent=1) + "\n")
        shutil.copytree(stage, work)
        old = base / "latest"
        if old.exists():
            old.rename(base / f".old-{os.getpid()}")
        work.rename(old)
        shutil.rmtree(base / f".old-{os.getpid()}", ignore_errors=True)
    except Exception as e:
        shutil.rmtree(work, ignore_errors=True)
        print(f"backup export FAILED: {e}", file=sys.stderr)
        return 1
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    size = sum(f["bytes"] for f in manifest["files"].values())
    prom = base / "logos_backup_export.prom"
    prom.with_suffix(".tmp").write_text(
        "# HELP logos_backup_export_last_success_timestamp_seconds When the Logos backup export last succeeded.\n"
        "# TYPE logos_backup_export_last_success_timestamp_seconds gauge\n"
        f"logos_backup_export_last_success_timestamp_seconds {int(time.time())}\n"
        "# HELP logos_backup_export_bytes Size of the latest Logos backup export.\n"
        "# TYPE logos_backup_export_bytes gauge\n"
        f"logos_backup_export_bytes {size}\n")
    prom.with_suffix(".tmp").rename(prom)
    print(f"backup export: {len(manifest['files'])} files, {size / 1e6:.1f} MB in {base / 'latest'} "
          f"(agents: {', '.join(manifest['agents'])})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
